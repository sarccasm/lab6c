@model OrderForm
<h1>@(Model.Id==0 ? "Нове замовлення" : "Редагування замовлення")</h1>
<form method="post" asp-action="@(Model.Id==0 ? "Create" : "Edit")" asp-route-id="@Model.Id">
<div asp-validation-summary="All" class="text-danger"></div>
<div class="form-group"><label asp-for="CustomerId">Покупець</label><select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-control"><option value="">Оберіть покупця</option></select></div>
<div class="form-group"><label asp-for="SupermarketId">Супермаркет</label><select asp-for="SupermarketId" asp-items="ViewBag.Supermarkets" class="form-control"><option value="">Оберіть супермаркет</option></select></div>
<div class="form-group"><label asp-for="OrderDate">Дата</label><input asp-for="OrderDate" type="date" class="form-control"/></div>
<p>Укажіть кількість потрібних товарів. Нуль означає, що товар не додається.</p>
<table class="table"><thead><tr><th>Товар</th><th>Ціна</th><th>Кількість</th></tr></thead><tbody>
@for(int i=0;i<Model.Lines.Count;i++){<tr><td>@Model.Lines[i].Name<input type="hidden" asp-for="Lines[i].ProductId"/></td><td>@Model.Lines[i].Price.ToString("0.00")</td><td><input asp-for="Lines[i].Quantity" type="number" min="0" max="100000" step="0.001"/><span asp-validation-for="Lines[i].Quantity" class="text-danger"></span></td></tr>}
</tbody></table><button class="btn btn-primary">Зберегти</button></form><a asp-action="Index">Назад</a>
