@model IEnumerable<Order>
<h1>Замовлення</h1><a asp-action="Create">Нове замовлення</a>
<table class="table"><thead><tr><th>Дата</th><th>Покупець</th><th>Супермаркет</th><th>Дії</th></tr></thead><tbody>
@foreach(var item in Model){<tr><td>@item.OrderDate.ToString("dd.MM.yyyy")</td><td>@item.Customer.FullName</td><td>@item.Supermarket.Name</td><td><a asp-action="Details" asp-route-id="@item.Id">Товари та сума</a> | <a asp-action="Edit" asp-route-id="@item.Id">Редагувати</a> | <a asp-action="Delete" asp-route-id="@item.Id">Видалити</a></td></tr>}
</tbody></table>
